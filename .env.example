# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Wrap the value in single quotes — it can contain '$', which Compose would otherwise interpolate.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost:8443
POSTGRES_DB=pawfectmatch
POSTGRES_USER=pawfectmatch
POSTGRES_PASSWORD=
# Replace PASSWORD with the same value as POSTGRES_PASSWORD (avoid @ : / in it; they break the URL)
DATABASE_URL=postgres://pawfectmatch:PASSWORD@db:5432/pawfectmatch
# ANALYTICS_DATABASE_URL= — pending Artur, SQLAlchemy event store target (A1/A5)
# ALEMBIC=  — pending Q-22 with Artur, leave unset until confirmed
# Grafana login at https://localhost:8443/grafana/. Both are required — compose refuses to start
# without them. Single-quote the password if it contains '$'. Grafana stores it on first start only:
# to change it later, run `docker compose exec grafana grafana cli admin reset-admin-password <new>`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

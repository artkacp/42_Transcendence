# ============================================================
# ft_transcendence – shared team .gitignore
# For personal/local-only exclusions, use .git/info/exclude
# ============================================================


# ── OS ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ── Editors & IDEs ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~


# ── Environment & Secrets ───────────────────────────────────
.env
.env.*
!.env.example
!.env.template
secrets/
*.key
*.crt
*.pem
*.p12
*.pfx
infrastructure/certs/out/


# ── Docker volumes ──────────────────────────────────────────
postgres_data/
pgdata/
pg_data/
redis_data/


# ── Python / Django ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
ENV/
.virtualenv/

# Django generated / runtime files
local_settings.py
staticfiles/
collected_static/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
pip-log.txt


# ── Node.js ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/cache
.yarn/install-state.gz
.pnpm-store/


# ── TypeScript / Frontend build ─────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# Framework caches (React/Next, Vue/Nuxt, Angular, Svelte, Vite – all covered until decided)
.next/
.nuxt/
.angular/
.svelte-kit/
.vite/
.parcel-cache/
.cache/


# ── Database ────────────────────────────────────────────────
*.sqlite3
*.db
dump*.sql
*.dump


# ── Monitoring: Prometheus / Grafana ────────────────────────
prometheus_data/
grafana_data/
grafana/data/


# ── File uploads & user media ───────────────────────────────
uploads/
media/
static/uploads/


# ── Logs ────────────────────────────────────────────────────
logs/
*.log
*.log.*


# ── Test & coverage output ──────────────────────────────────
.coverage
coverage.xml
htmlcov/
coverage/
jest-coverage/
test-results/
.nyc_output/


# ── Compiled artifacts ──────────────────────────────────────
a.out
*.a
*.o
*.so

.claude/settings.local.json
.local/

CLAUDE.md

.claude